GEMINI_API_KEY=your-gemini-api-key-here

# Local dev: a libSQL file on disk. The directory will be created automatically.
TURSO_DATABASE_URL=file:./data/agora.db

# Production (Turso): set both of these from `turso db show <name>` and
# `turso db tokens create <name>`. Leave blank for local dev.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
